{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.11.2/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "initial-version": "0.1.0",
  "version-file": "version.txt",
  "skip-github-release": false,
  "draft": true,
  "force-tag-creation": true,
  "pull-request-title-pattern": "chore${scope}: release${component} ${version}",
  "pull-request-header": "Release Please proposes a community kit version from Conventional Commits. Maintainers must review the content, CI results, and distribution rights before merging.",
  "pull-request-footer": "Generated by [Release Please](https://github.com/googleapis/release-please). After the version PR is merged, Release Please creates a draft GitHub Release; the trusted workflow builds, attests, attaches the ZIP/checksum, and publishes it after all checks pass.",
  "changelog-sections": [
    {"type": "feat", "section": "Features"},
    {"type": "feature", "section": "Features"},
    {"type": "fix", "section": "Bug Fixes"},
    {"type": "perf", "section": "Performance"},
    {"type": "revert", "section": "Reverts"},
    {"type": "docs", "section": "Documentation", "hidden": true},
    {"type": "style", "section": "Formatting", "hidden": true},
    {"type": "chore", "section": "Maintenance", "hidden": true},
    {"type": "refactor", "section": "Refactoring", "hidden": true},
    {"type": "test", "section": "Tests", "hidden": true},
    {"type": "build", "section": "Build", "hidden": true},
    {"type": "ci", "section": "CI", "hidden": true}
  ],
  "packages": {".": {}}
}
